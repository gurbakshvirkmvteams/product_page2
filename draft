<div class="product-custom-upload" style="margin: 15px 0;">
  <label for="custom-image-upload" style="display: block; margin-bottom: 5px; font-weight: 500;">
    Upload Your Image <span style="color: red;">*</span>
  </label>
  <input 
    type="file" 
    id="custom-image-upload" 
    name="properties[Custom Image]" 
    accept="image/*" 
    form="product-form-{{ section.id }}" 
    required
  >
</div>