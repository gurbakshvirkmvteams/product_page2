              <path d="M17.8293 8.09669C17.5445 7.74964 17.1832 7.46946 16.772 7.27691C16.3609 7.08436 15.9105 6.98437 15.4543 6.98438C14.9981 6.98437 14.5477 7.08436 14.1366 7.27691C13.7254 7.46946 13.3641 7.74964 13.0793 8.09669C12.7925 8.44843 12.5938 8.86041 12.4989 9.29995C12.4041 9.73949 12.4158 10.1945 12.533 10.6289L14.2668 17.6242C14.3312 17.8742 14.4795 18.0961 14.6881 18.2547C14.8968 18.4132 15.154 18.4993 15.4187 18.4993C15.6834 18.4993 15.9405 18.4132 16.1492 18.2547C16.3579 18.0961 16.5062 17.8742 16.5705 17.6242L18.3637 10.6173C18.4806 10.1855 18.4932 9.73323 18.4005 9.2959C18.3078 8.85857 18.1123 8.4481 17.8293 8.09669ZM16.0955 10.0623L15.4543 12.5829L14.813 10.0623C14.7844 9.96743 14.7803 9.86714 14.801 9.77033C14.8217 9.67352 14.8667 9.58318 14.9318 9.50731C14.9926 9.42833 15.0715 9.36423 15.1622 9.32008C15.2529 9.27593 15.3529 9.25294 15.4543 9.25294C15.5557 9.25294 15.6557 9.27593 15.7464 9.32008C15.8371 9.36423 15.916 9.42833 15.9768 9.50731C16.0419 9.58318 16.0869 9.67352 16.1076 9.77033C16.1283 9.86714 16.1242 9.96743 16.0955 10.0623Z" fill="white" />
              <path d="M15.4531 23.1279C16.4369 23.1279 17.2344 22.3514 17.2344 21.3936C17.2344 20.4357 16.4369 19.6592 15.4531 19.6592C14.4694 19.6592 13.6719 20.4357 13.6719 21.3936C13.6719 22.3514 14.4694 23.1279 15.4531 23.1279Z" fill="white" />
            </svg>
          </div>
          <div class="description-warning-banner-text">
            <p>Attention</p>
          </div>
        </div>
        <p class="description-w">{{ section.settings.description_warning_text }}</p>
      </div>
    </div>

  </div>
</section>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const tabButtons = document.querySelectorAll('.description-tab-item-button');
        const tabContents = document.querySelectorAll('.description-tab-content');
        tabButtons[0].classList.add('active');
        tabContents[0].classList.add('active');

        tabButtons.forEach(button => {
            button.classList.remove('active');
            button.addEventListener('click', () => {
                const tabId = button.getAttribute('data-tab-id');
                tabButtons.forEach(btn => {
                    btn.classList.remove('active');
                });
                button.classList.add('active');
                tabContents.forEach(tabcontent => {
                    tabcontent.classList.remove('active');
                    if (tabcontent.getAttribute('data-tab-id') === tabId) {
                        tabcontent.classList.add('active');
                    } else {
                        tabcontent.classList.remove('active');
                    }
                });
            });
        });
    });
</script>
{% schema %}
  {
    "name": "Description Tabs",
    "settings": [
      {
        "type": "range",
        "id": "padding_top",
        "min": 10,
        "max": 100,
        "step": 1,
        "default": 61,
        "unit": "px",
        "label": "Padding Top"
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 10,
        "max": 100,
        "step": 1,
        "default": 89,
        "unit": "px",
        "label": "Padding Bottom"
      }, {
        "type": "text",
        "id": "description_warning_text",
        "label": "Warning Text",
        "default": "Due to the recent high demand for my work and the number of orders I am receiving, I can only take a set amount of orders per day. If the add to cart button still works, it means it is your lucky day. Hurry and order now while there are spaces left!"
      }
    ],
    "blocks": [
      {
        "type": "description-item",
        "name": "Description Item",
        "settings": [
          {
            "type": "text",
            "id": "description_title_button",
            "label": "Title"
          }, {
            "type": "text",
            "id": "short_descrition",
            "label": "Short Description"
          }, {
            "type": "richtext",
            "id": "descrition",
            "label": "Description"
          }, {
            "type": "image_picker",
            "id": "description_image",
            "label": "Image"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Description Tabs"
      }
    ]
  }
{% endschema %}