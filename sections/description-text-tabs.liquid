<section>
  <div>
    {% if section.blocks.size > 1 %}
      <div class="description-tab-items">
        {% for block in section.blocks %}
          <button class="description-tab-item-button" data-tab-id="{{ block.settings.description_title_button }}">
            {{ block.settings.description_title_button }}
          </button>
        {% endfor %}
      </div>
    {% endif %}
    <div class="description-tab-item product-content-container page-width" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
      {% for block in section.blocks %}
        <div class="description-tab-content" data-tab-id="{{ block.settings.description_title_button }}">
          {% if block.settings.description_image != blank %}
            <div class="description-tab-image">
              {{ block.settings.description_image | image_url: width: 600 | image_tag }}
            </div>
          {% endif %}
          <div class="description-tab-text">
            <p class="short-desc">{{ block.settings.short_descrition }}</p>
            <div class="long-desc">{{ block.settings.descrition }}</div>
          </div>
        </div>
      {% endfor %}

      <div class="description-warning">
        <div class="description-warning-text">
          <div class="warning-banner">
            <svg
              width="31"
              height="28"
              viewBox="0 0 31 28"
              fill="none"
              xmlns="http://www.w3.org/2000/svg">
