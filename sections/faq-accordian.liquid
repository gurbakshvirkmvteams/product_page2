<style>
  .faq-section {
    text-align: center;
  }

.faq-section__title {
font-size: 32px;
line-height: 100%;
letter-spacing: 0%;
}
.faq-section__container {
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.faq-item {
  background-color: #FFFFFF;
  max-width: 1090px;
  text-align: left;
  padding: 20px 28px;
  border: 1px solid #E5E5E5;
}
.faq-item__question {
font-weight: 600;
font-size: 16px;
line-height: 100%;
letter-spacing: 0%;
color: #000000;
}
.faq-item__answer {
    margin: 24px 0 0;
    font-weight: 400;
    font-size: 14px;
    line-height: 1.4;
    letter-spacing: 0%;
    display: none;
}
</style>
<section class="faq-section " style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color:{{ section.settings.faq_background_color }}">
  <div class="product-content-container page-width">
    {% if section.settings.faq_section_title != blank %}
      <h2 class="faq-section__title">{{ section.settings.faq_section_title }}</h2>
    {% endif %}
    <div class="faq-section__container">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'faq_item' %}
            {% if block.settings.faq_question != blank and block.settings.faq_answer != blank %}
              <div class="faq-item" {{ block.shopify_attributes }}>
                <div class="faq-item__question">
                  <span>{{ block.settings.faq_question }}</span>
                </div>
                <div class="faq-item__answer">
                  {{ block.settings.faq_answer }}
                </div>
              </div>
            {% endif %}
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "FAQ Accordion",
    "settings": [
      {
        "type": "range",
        "id": "padding_top",
        "min": 10,
        "max": 100,
        "step": 1,
        "default": 57,
        "unit": "px",
        "label": "Padding Top"
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 10,
        "max": 100,
        "step": 1,
        "default": 68,
        "unit": "px",
        "label": "Padding Bottom"
      }, {
        "type": "color",
        "id": "faq_background_color",
        "label": "Background Color"
      }, {
        "type": "text",
        "id": "faq_section_title",
        "label": "Section Heading"
      }
    ],
    "blocks": [
      {
        "type": "faq_item",
        "name": "FAQ Item",
        "settings": [
          {
            "type": "text",
            "id": "faq_question",
            "label": "Question"
          }, {
            "type": "richtext",
            "id": "faq_answer",
            "label": "Answer"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "FAQ Accordion"
      }
    ]
  }
{% endschema %}