<style>
  .support-section-container{
    text-align: center;
  }
.suppport-card{
  display: flex;
  flex-direction: column;
  align-items: center;
}
.support-section-container .support-section-heading{
  font-size: 32px;
  line-height: 1.4;
  letter-spacing: 0%;
  margin: 0 0 48px;
}
.support-card-icon{
  max-width: 40px;
  max-height: 40px;
}
.support-card-icon img, .icon-large img{
  width: 100%;
  height: 100%;
}
.support-card-heading{
  font-size: 18px;
  line-height: 1.4;
  letter-spacing: 0%;
  margin:9px 0 20px;
}
.icon-large{
  max-width: 56px;
  max-height: fit-content;
}
.heading-small{
  font-size: 16px;
  line-height: 1.4;
  letter-spacing: 0%;
  margin:22px 0 8px;

}
.suppport-card p{
  font-size: 14px;
  line-height: 1.5;
  letter-spacing: 0%;
  text-align: center;
  margin: 0;
  max-width: 328px;
}
/* card_style */
</style>
<section style="background-color:{{ section.settings.background_color }};">
<div class="support-section-container" style="padding-top: {{ section.settings.padding_top }}px;
            padding-bottom: {{ section.settings.padding_bottom }}px;">
              {% if section.settings.section_heading != blank %}
                <h2 class="support-section-heading">{{ section.settings.section_heading }}</h2>
              {% endif %}
    <div class="our-support-wrapper page-width product-content-container"
            
            >
            
        {% for block in section.blocks %}
          {% comment %} {{ section.settings.card_style }} {% endcomment %}
            <div class="suppport-card">
                <div class="{%- if section.settings.card_style ==  'small-icon-large-heading' -%}
                            support-card-icon
                          {%- else -%}
                            icon-large
                          {%- endif -%}"
                          >
                  {%- if block.settings.support_icon != blank -%}
                      {{ block.settings.support_icon | image_url: width: 400 | image_tag }}
                  {%- endif  -%}
                </div>
                <h2 class="{%- if section.settings.card_style ==  "small-icon-large-heading" -%}
                              support-card-heading
                            {%- else -%}
                              heading-small
                            {%- endif -%}"
                            >
                    {{ block.settings.support_heading }}</h2>
                <p>{{ block.settings.support_description }}</p>
            </div>
        {% endfor %}
    </div>
</div>
</section>
{% schema %}
  {
    "name": "Our Support",
    "settings": [
      {
        "type": "text",
        "id": "section_heading",
        "label": "Add Section Heading"
      },
        {
        "type": "color",
        "id": "background_color",
        "label": "Section Color"
      }, 
      {
        "type": "range",
        "id": "padding_top",
        "min": 10,
        "max": 100,
        "step": 1,
        "default": 42,
        "unit": "px",
        "label": "Padding Top"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 10,
        "max": 100,
        "step": 1,
        "default": 14,
        "unit": "px",
        "label": "Padding Bottom"
      },
      {
        "type": "select",
        "id": "card_style",
        "options": [
          {
            "value": "small-icon-large-heading",
            "label": "Small Icon Large Heading"
          },
          {
            "value": "large-icon-small-heading",
            "label": "Large Icon Small Heading"
          }
        ],
          "default": "small-icon-large-heading",
          "label": "Sizing"
      }
    ],
    "blocks": [
      {
        "type": "image",
        "name": "Card",
        "limit": 3,
        "settings": [
          {
            "type": "image_picker",
            "id": "support_icon",
            "label": "Add Icon"
          }, {
            "type": "text",
            "id": "support_heading",
            "label": "Add Heading"
          }, {
            "type": "richtext",
            "id": "support_description",
            "label": "Add description"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Our Support"
      }
    ]
  }
{% endschema %}