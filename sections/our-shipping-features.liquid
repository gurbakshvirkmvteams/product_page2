<section style="background-color:{{ section.settings.background_color }};">
  <div class="support-section-container" style="padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;">
        {% if section.settings.section_heading != blank %}
          <h2 class="support-section-heading">{{ section.settings.section_heading }}</h2>
        {% endif %}
        <div class="our-support-wrapper page-width product-content-container">
            {% for block in section.blocks %}
              {% comment %} {{ section.settings.card_style }} {% endcomment %}
                <div class="suppport-card">
                    <div class="{%- if section.settings.card_style ==  'small-icon-large-heading' -%}
                                support-card-icon
                              {%- else -%}
                                icon-large
                              {%- endif -%}"
                              >
                      {%- if block.settings.support_icon != blank -%}
                          {{ block.settings.support_icon | image_url: width: 400 | image_tag }}
                      {%- endif  -%}
                    </div>
                    <h2 class="{%- if section.settings.card_style ==  "small-icon-large-heading" -%}
                                  support-card-heading
                                {%- else -%}
                                  heading-small
                                {%- endif -%}"
                                >
                        {{ block.settings.support_heading }}</h2>
                    <p>{{ block.settings.support_description }}</p>
                </div>
            {% endfor %}
        </div>
  </div>
</section>
{% schema %}
  {
    "name": "Our Support",
    "settings": [
      {
        "type": "text",
        "id": "section_heading",
        "label": "Add Section Heading"
      },
        {
        "type": "color",
        "id": "background_color",
        "label": "Section Color"
      }, 
      {
        "type": "range",
        "id": "padding_top",
        "min": 10,
        "max": 100,
        "step": 1,
        "default": 42,
        "unit": "px",
        "label": "Padding Top"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 10,
        "max": 100,
        "step": 1,
        "default": 14,
        "unit": "px",
        "label": "Padding Bottom"
      },
      {
        "type": "select",
        "id": "card_style",
        "options": [
          {
            "value": "small-icon-large-heading",
            "label": "Small Icon Large Heading"
          },
          {
            "value": "large-icon-small-heading",
            "label": "Large Icon Small Heading"
          }
        ],
          "default": "small-icon-large-heading",
          "label": "Sizing"
      }
    ],
    "blocks": [
      {
        "type": "image",
        "name": "Card",
        "limit": 3,
        "settings": [
          {
            "type": "image_picker",
            "id": "support_icon",
            "label": "Add Icon"
          }, {
            "type": "text",
            "id": "support_heading",
            "label": "Add Heading"
          }, {
            "type": "richtext",
            "id": "support_description",
            "label": "Add description"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Our Support"
      }
    ]
  }
{% endschema %}