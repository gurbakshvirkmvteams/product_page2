<style>
  .social-section-container {
    display: flex;
    /* flex-wrap: wrap; */
    justify-content: center;
    gap: 94px;
  }
  .social-section-logo {
    max-width: 183px;
    margin-bottom: 42px;
  }
  .social-section-logo img {
    width: 100%;
    height: 100%;
  }
  .social-images-wrapper {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    max-width: 541px;
    aspect-ratio: 1 / 1;
  }
  .social-content-wrapper {
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 449px;
  }
  .social-card-image {
    /* max-width: 138px; */
    aspect-ratio: 1 / 1;
    width: 100%;
    height: fit-content;
  }
  .social-card-image img {
    width: 100%;
    height: 100%;
    display: block;
  }
  .social-reach-details {
    font-weight: 700;
    font-size: 14px;
    line-height: 100%;
    letter-spacing: 0;
    display: flex;
    gap: clamp(16px, 3vw, 47px);
    margin: 0 0 10px;
  }
  .social-content-tagline h3 {
    font-weight: 700;
    font-size: clamp(28px, 2.5vw, 40px);
    line-height: 1.4;
    letter-spacing: 0;
    margin: 0;
  }
  .social-reach-details span:nth-child(2) {
    color: rgb(var(--gradient-base-accent-2)) !important;
  }
  .social-content-tagline h3 a,
  .social-content-description * a {
    all: unset;
    cursor: pointer;
/* color:var(--color-badge-background); */
    color: rgb(var(--gradient-base-accent-2)) !important;

  }
  .social-content-description * {
    max-width: 384px;
    font-weight: 400;
    font-size: 18px;
    line-height: 1.4;
    letter-spacing: 0;
    margin:15px 0 0 !important  ;
  }
  .social-content-description-btn {
    all: unset;
    padding: 18px 35px;
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    background: rgba(var(--color-button), var(--alpha-button-background)) !important;
    border-radius: 35px;
    font-weight: 600;
    font-size: 18px;
    line-height: 100%;
    letter-spacing: 0;
    color: #FFFFFF;
    margin-top: 33px;
  }
  @media (max-width: 750px) {
    .social-section-container {
      flex-direction: column;
    }
    .social-images-wrapper {
      max-width: 100%;
      height: fit-content;
    }
  }
</style>

<section class="social-section " style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color:{{ section.settings.social_background_color }}">
  <div class="social-section-container product-content-container page-width">
    <div class="social-content-wrapper">
      {% comment %} {{ section.settings.social_logo | image_url: width: 183 | image_tag: loading: 'lazy' }} {% endcomment %}
      {% if section.settings.social_logo %}
        <div class="social-section-logo">
          {{ section.settings.social_logo | image_url: width: 137 | image_tag: loading: 'lazy' }}
        </div>
      {% endif %}
      <div class="social-reach-details">
        <span>{{ section.settings.social_posts }}</span>
        <span>{{ section.settings.social_followers }}</span>
      </div>
      <div class="social-content-tagline">{{ section.settings.social_tagline }}</div>
      <div class="social-content-description">{{ section.settings.social_link_description }}</div>
      {% if section.settings.social_button %}
        <a href="{{ section.settings.social_button_link_url }}" class="social-content-description-btn">
          {% if section.settings.social_button_image %}
            {{ section.settings.social_button_image | image_url: width: 26 | image_tag: loading: 'lazy' }}
          {% endif %}
          {{ section.settings.social_button }}
        </a>
      {% endif %}
    </div>

    <div class="social-images-wrapper">
      {% for block in section.blocks %}
        {% if block.settings.social_card_image %}
          <div class="social-card-image">
            {{ block.settings.social_card_image | image_url: width: 260 | image_tag: loading: 'lazy' }}
          </div>
        {% endif %}
      {% endfor %}
    </div>
    
  </div>
</section>
{% schema %}
  {
    "name": "Our Social",
    "settings": [
      {
        "type": "range",
        "id": "padding_top",
        "min": 10,
        "max": 100,
        "step": 1,
        "default": 57,
        "unit": "px",
        "label": "Padding Top"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 10,
        "max": 100,
        "step": 1,
        "default": 68,
        "unit": "px",
        "label": "Padding Bottom"
      },
      {
        "type": "color",
        "id": "social_background_color",
        "label": "Background Color"
      },
      {
        "type": "header",
        "content": "Social Content"
      }, {
        "type": "image_picker",
        "id": "social_logo",
        "label": "Add Image"
      }, {
        "type": "text",
        "id": "social_posts",
        "label": "Add Posts count"
      }, {
        "type": "text",
        "id": "social_followers",
        "label": "Add Followers count"
      }, {
        "type": "richtext",
        "id": "social_tagline",
        "label": "Add Our Social Tagline"
      }, {
        "type": "richtext",
        "id": "social_link_description",
        "label": "Social Description"
      }, {
        "type": "image_picker",
        "id": "social_button_image",
        "label": "Social Button Icon"
      }, {
        "type": "text",
        "id": "social_button",
        "label": "Add Social Button Name"
      }, {
        "type": "url",
        "id": "social_button_link_url",
        "label": "Social Button Link"
      }
    ],
    "blocks": [
      {
        "type": "image",
        "name": "Images",
        "limit": 9,
        "settings": [
          {
            "type": "image_picker",
            "id": "social_card_image",
            "label": "Add Image"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Our Social"
      }
    ]
  }
{% endschema %}