<style>
  .procedure-section-heading {
    font-size: 38px;
    line-height: 100%;
    letter-spacing: 0;
    margin: 0;
  }
  .procedure-section-wrapper {
    text-align: center;
  }


  .procedure-card-image-wrapper {
    max-width: 174px;
    height: auto;
    border: 3px solid #FFFFFF;
    border-radius: 50%;
    overflow: hidden;
    margin-top: 78px;
    z-index: 1;

  }
  .procedure-card-image-wrapper img {
    width: 100%;
    height: 100%;
  }
  .procedure-card-text-heading {
    font-size: 20px;
    line-height: 100%;
    letter-spacing: 0;
    margin: 20px 0 0;
  }
  .procedure-card-body p {
    font-size: 16px;
    line-height: 100%;
    letter-spacing: 0;
    max-width: 386px;
  }
  .procedure-card-body {
    z-index: 1;
  }
  .procedure-card-body:first-child {
    z-index: 2;
  }
  .procedure-cards-wrapper {
    display: flex;
    justify-content: space-around;
    position: relative;
  }

  .procedure-card-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    /* width: 33.333%; */
  }
  .procedure-card-body:nth-child(2)::before {
    content: "";
    position: absolute;
    width: clamp(200px, 18.5vw, 326px);
    height: 100px;
    background-image: var(--paw-trail-1);
    background-repeat: no-repeat;
    background-size: contain;
    background-position: center;
    top: 36%;
    right: 78%;

    z-index: 1;
    pointer-events: none;
  }

  .procedure-card-body:nth-child(2)::after {
    content: "";
    position: absolute;
    width: clamp(200px, 18.5vw, 326px);
    height: 100px;
    background-image: var(--paw-trail-2);
    background-repeat: no-repeat;
    background-size: contain;
    background-position: center;
    top: 22%;
    left: 77%;
    z-index: 0;
    pointer-events: none;
  }

</style>
<section style="background-color:{{ section.settings.procedure_background_color }};">
  <div class="procedure-section-wrapper" style="padding-top: {{ section.settings.padding_top }}px;
            padding-bottom: {{ section.settings.padding_bottom }}px;">
    {% if section.settings.procedure_section_heading != blank %}
      <h2 class="procedure-section-heading">{{ section.settings.procedure_section_heading }}</h2>
    {% endif %}
    <div class="procedure-cards-wrapper page-width" style="
    --paw-trail-1: url('{{ section.settings.paw_trail_1 | image_url: width: 500 }}');
    --paw-trail-2: url('{{ section.settings.paw_trail_2 | image_url: width: 500 }}');
  ">
      {% for block in section.blocks %}
        {% comment %} {{ section.settings.card_style }} {% endcomment %}
        <div class="procedure-card-body">
          <div class="procedure-card-image-wrapper">
            {%- if block.settings.procedure_icon != blank -%}
              {{ block.settings.procedure_icon | image_url: width: 400 | image_tag }}
            {%- endif -%}
          </div>
          <h2 class="procedure-card-text-heading">
            {{ block.settings.procedure_heading }}</h2>
          <p>{{ block.settings.procedure_description }}</p>


        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
  {
    "name": "Our Procedure",
    "settings": [
      {
        "type": "text",
        "id": "procedure_section_heading",
        "label": "Add Section Heading"
      },
      {
        "type": "color",
        "id": "procedure_background_color",
        "label": "Section Color"
      },
      {
        "type": "header",
        "content": "Decorative Paw Print Tracks"
      },
      {
        "type": "image_picker",
        "id": "paw_trail_1",
        "label": "1st Pawprint"
      }, {
        "type": "image_picker",
        "id": "paw_trail_2",
        "label": "2nd Pawprint"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 10,
        "max": 100,
        "step": 1,
        "default": 42,
        "unit": "px",
        "label": "Padding Top"
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 10,
        "max": 100,
        "step": 1,
        "default": 14,
        "unit": "px",
        "label": "Padding Bottom"
      }
    ],
    "blocks": [
      {
        "type": "image",
        "name": "Card",
        "limit": 3,
        "settings": [
          {
            "type": "image_picker",
            "id": "procedure_icon",
            "label": "Add Icon"
          }, {
            "type": "text",
            "id": "procedure_heading",
            "label": "Add Heading"
          }, {
            "type": "richtext",
            "id": "procedure_description",
            "label": "Add description"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Our Procedure"
      }
    ]
  }
{% endschema %}