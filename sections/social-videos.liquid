<section class="tiktok-section page-width" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color:{{ section.settings.social_section_background }}">
  <div class="tiktok-section__header">
    {% if section.settings.our_social_logo != blank %}
      <div class="tiktok-section__logo">
        {{ section.settings.our_social_logo | image_url: width: 200 | image_tag }}
      </div>
    {% endif %}

    <p class="tiktok-section__subtitle">Follow us on
      <span>{{ section.settings.our_social_handle }}</span>
    </p>
  </div>

  <div class="tiktok-section__videos">
    {% for block in section.blocks %}
      <div class="tiktok-card" {{ block.shopify_attributes }}>
        {% if block.settings.video != blank %}
          {{ block.settings.video | video_tag: loop: true, muted: true, controls: false, playsinline: true }}

          <div class="tiktok-card__play"></div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
  {
    "name": "TikTok videos",
    "settings": [
      {
        "type": "color",
        "id": "social_section_background",
        "label": "Add Background Color",
        "default": "#F8F8F8"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 10,
        "max": 100,
        "step": 1,
        "default": 57,
        "unit": "px",
        "label": "Padding Top"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 10,
        "max": 100,
        "step": 1,
        "default": 68,
        "unit": "px",
        "label": "Padding Bottom"
      },
      {
        "type": "image_picker",
        "id": "our_social_logo",
        "label": "Add Logo"
      }, {
        "type": "text",
        "id": "our_social_handle",
        "label": "Add Social Handle"
      }
    ],
    "blocks": [
      {
        "type": "video",
        "name": "Video",
        "limit": 6,
        "settings": [
          {
            "type": "video",
            "id": "video",
            "label": "Video"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "TikTok videos"
      }
    ]
  }
{% endschema %}